{
  "name": "Player",
  "type": "object",
  "title": "Profil public du joueur",
  "properties": {
    "uid": {
      "type": "string"
    },
    "xp": {
      "type": "number",
      "default": 0
    },
    "data": {
      "type": "object"
    }
  },
  "required": [
    "uid"
  ],
  "rls": {
    "create": {
      "data.uid": "{{user.id}}"
    },
    "read": null,
    "update": {
      "created_by": "{{user.email}}"
    },
    "delete": {
      "created_by": "{{user.email}}"
    }
  }
}